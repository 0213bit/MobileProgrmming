<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_my_code_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="내 친구 코드 (클릭해서 복사)"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_my_uid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="로그인 정보를 불러오는 중..."
        android:background="#EEE"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_my_code_label" />

    <TextView
        android:id="@+id/tv_add_friend_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="친구 추가하기"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_my_uid" />

    <EditText
        android:id="@+id/et_friend_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="친구의 코드를 입력하세요"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_add_friend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_add_friend_label" />

    <Button
        android:id="@+id/btn_add_friend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="등록"
        app:layout_constraintBottom_toBottomOf="@+id/et_friend_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_friend_code" />

    <TextView
        android:id="@+id/tv_list_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="친구 목록"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_friend_code" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_friends"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_list_label" />

</androidx.constraintlayout.widget.ConstraintLayout>